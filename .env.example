# ---- Roadside SSO: copy to .env for local development ----
NODE_ENV=development
PORT=8787

# Postgres (local docker compose default). Railway injects DATABASE_URL automatically.
DATABASE_URL=postgres://roadside:roadside@localhost:5436/roadside_sso

# Public URL of this SSO (used as the OIDC issuer and in redirect links).
# Local: http://localhost:8787   Railway: https://<your-service>.up.railway.app or your custom domain
PUBLIC_URL=http://localhost:8787

# Secret used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# First-run bootstrap (only used when the users table is empty)
BOOTSTRAP_ADMIN_EMAIL=admin@roadside.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_TENANT_NAME=Roadside Towing
BOOTSTRAP_TENANT_SLUG=roadside

# Optional: comma separated origins allowed to call the API from the browser (portal dev server is added automatically)
CORS_ORIGINS=

# Encrypts mailbox app passwords at rest (Mail page). Generate like SESSION_SECRET. Changing it invalidates saved mailboxes.
MAIL_ENCRYPTION_KEY=
# How often to check mailboxes for new mail (seconds)
MAIL_SYNC_SECONDS=180
